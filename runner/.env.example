# to test inside docker, enter a path inside /app
# make sure ONLY log files are created/modified in this path
FILE_PATH=
AGENTIC_MODE=

# ip address of the admin server
# use `ftp-grpc-server` if using docker compose 
# or use 127.0.0.1 for local development
ADMIN_SERVER_HOST=ftp-grpc-server
ADMIN_SERVER_PORT=50051

# name of the admin server
# the admin server checks if the ID starts with A.
# so make sure to use a valid ID.
ADMIN_ID=A001

# name of the bank sending (ex: B_HDFC)
SENDER_BANK_ID=B_test

# for the docker container
MONGO_INITDB_ROOT_BANK_USERNAME=
MONGO_INITDB_ROOT_BANK_PASSWORD=