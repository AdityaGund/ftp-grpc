SERVER_HOST=0.0.0.0
SERVER_PORT=50051
SERVER_HTTP_HOST=0.0.0.0
SERVER_HTTP_PORT=50052
JWT_SECRET=


# these are the paths inside the server container
JWT_PRIVATE_KEY_PATH=/app/keys/admin_private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/admin_public.pem

# either get a URI from Atlas or use the docker container.
# the container name is `mongoAdmin` as set in the docker compose file.
# if using the docker compose for mongo, use the same <username> & <password> as set below.
MONGO_URI=mongodb://<username>:<password>@mongoAdmin:27017/?authSource=admin

# for docker containers
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=